<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CookBookApp.MainPage"
             BackgroundColor="#7A5C52">

    <!-- Resources -->
    <ContentPage.Resources>

        <!-- Styl ramek filtrów -->
        <Style x:Key="FilterSectionStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="#A87465"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HasShadow" Value="False"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Szablon dla CheckBox + Label -->
        <ControlTemplate x:Key="CheckBoxLabelTemplate">
            <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                <CheckBox/>
                <Label Text="{TemplateBinding Content}" TextColor="Black" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </ControlTemplate>

        <!-- Reusable Control -->
        <ControlTemplate x:Key="CheckBoxLabel">
            <ContentView ControlTemplate="{StaticResource CheckBoxLabelTemplate}"/>
        </ControlTemplate>

    </ContentPage.Resources>

    <!-- Główna zawartość -->
    <ScrollView>

        <Grid Padding="20" RowDefinitions="Auto, Auto, *" ColumnDefinitions="*,Auto">

            <!-- Przyciski + wyszukiwarka -->
            <HorizontalStackLayout Padding="10" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">

                <!-- Przyciski -->
                <Frame BorderColor="White" CornerRadius="15" Padding="12" BackgroundColor="#D8B4A0" HasShadow="True">
                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Dodaj Nowy Przepis"
                                BackgroundColor="#A85400"
                                TextColor="White"
                                FontAttributes="Bold"
                                WidthRequest="180"
                                HeightRequest="45"
                                CornerRadius="10"
                                BorderColor="White"
                                BorderWidth="1"
                                Clicked="OnAddRecipeClicked"/>
                        <Button Text="Wyszukaj Przepis"
                                BackgroundColor="#A85400"
                                TextColor="White"
                                FontAttributes="Bold"
                                WidthRequest="180"
                                HeightRequest="45"
                                CornerRadius="10"
                                BorderColor="White"
                                BorderWidth="1"
                                Clicked="OnSearchRecipeClicked"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Wyszukiwarka -->
                <Frame CornerRadius="15" BackgroundColor="#D8B4A0" BorderColor="#D8B4A0" Padding="8" WidthRequest="380">
                    <Entry x:Name="RecipeNameEntry"
                           Placeholder="Wpisz nazwę przepisu..."
                           FontSize="18"
                           BackgroundColor="AntiqueWhite"
                           TextColor="Black"
                           HorizontalTextAlignment="Center"/>
                </Frame>

            </HorizontalStackLayout>

            <!-- Licznik przepisów -->
            <Frame Grid.Row="1" Margin="30,10,0,0" WidthRequest="40" HeightRequest="30"
                   CornerRadius="10" BackgroundColor="White" BorderColor="#A85400" Padding="5">
                <Label x:Name="ResultsCountLabel"
                       Text="0"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#A85400"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Frame>

            <!-- Filtry -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*,*" Padding="10" RowSpacing="20">

                <!-- Sekcje filtrów -->
                <!-- RODZAJ DANIA -->
                <VerticalStackLayout Grid.Column="0">
                    <Frame Style="{StaticResource FilterSectionStyle}">
                        <Label Text="RODZAJ DANIA" FontAttributes="Bold" TextColor="White" FontSize="20" HorizontalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Margin="10,0">
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Śniadania" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Przystawki i przekąski" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Zupy" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Dania główne" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Desery" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Pieczywo i wypieki" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Napoje" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Sosy i dodatki" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- KUCHNIA ŚWIATA -->
                <VerticalStackLayout Grid.Column="1">
                    <Frame Style="{StaticResource FilterSectionStyle}">
                        <Label Text="KUCHNIA ŚWIATA" FontAttributes="Bold" TextColor="White" FontSize="20" HorizontalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Margin="10,0">
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Polska" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Włoska" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Francuska" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Azjatycka" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Meksykańska" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Śródziemnomorska" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- GŁÓWNY SKŁADNIK -->
                <VerticalStackLayout Grid.Column="2">
                    <Frame Style="{StaticResource FilterSectionStyle}">
                        <Label Text="GŁÓWNY SKŁADNIK" FontAttributes="Bold" TextColor="White" FontSize="20" HorizontalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Margin="10,0">
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Śródziemnomorska" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Rybne i owoce morza" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Wegetariańskie" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Wegańskie" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Bezglutenowe" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- OKAZJA -->
                <VerticalStackLayout Grid.Column="3">
                    <Frame Style="{StaticResource FilterSectionStyle}">
                        <Label Text="OKAZJA" FontAttributes="Bold" TextColor="White" FontSize="20" HorizontalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Margin="10,0">
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Codzienne obiady" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Świąteczne dania" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Imprezowe przekąski" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Grillowe specjały" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Dania na wynos i do lunchboxa" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- STOPIEŃ TRUDNOŚCI -->
                <VerticalStackLayout Grid.Column="4">
                    <Frame Style="{StaticResource FilterSectionStyle}">
                        <Label Text="STOPIEŃ TRUDNOŚCI" FontAttributes="Bold" TextColor="White" FontSize="20" HorizontalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Margin="10,0">
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Szybkie i łatwe" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Średniozaawansowane" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5,5,0,5" Spacing="8">
                            <CheckBox/>
                            <Label Text="Zaawansowane" TextColor="Black" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </Grid>

        </Grid>

    </ScrollView>

</ContentPage>
