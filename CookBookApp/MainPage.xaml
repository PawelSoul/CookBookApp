<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CookBookApp.MainPage"
             BackgroundColor="#7A5C52">

    <ContentPage.Resources>
        <Style x:Key="FilterSectionStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="#A87465"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HasShadow" Value="False"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
        <!-- Menu Top -->
        <Frame BackgroundColor="#D8B4A0" Padding="10" Margin="10" CornerRadius="20">
            <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" HorizontalOptions="FillAndExpand" ColumnSpacing="20">
                <Button Grid.Column="0"
                Text="Wyszukaj"
                BackgroundColor="#A85400"
                TextColor="White"
                WidthRequest="100"
                Clicked="OnSearchRecipeClicked"
                VerticalOptions="Center"/>

                <Entry Grid.Column="1"
                   x:Name="RecipeNameEntry"
                   Placeholder="Wpisz nazwę przepisu..."
                   FontSize="16"
                   BackgroundColor="White"
                   TextColor="Black"
                   HorizontalTextAlignment="Start"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- Dodaj Przepis -->
        <Button Grid.Row="1"
                Text="Dodaj Nowy Przepis"
                BackgroundColor="#A85400"
                TextColor="White"
                FontAttributes="Bold"
                Margin="10"
                HeightRequest="45"
                CornerRadius="10"
                Clicked="OnAddRecipeClicked"/>

        <!-- Główna sekcja: Filtry + Wyniki -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,5*" Padding="10" RowSpacing="20" ColumnSpacing="10">
            <!-- Filtry -->
            <ScrollView>
                <VerticalStackLayout Spacing="10">
                    <!-- RODZAJ DANIA -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Frame Style="{StaticResource FilterSectionStyle}">
                                <Label Text="RODZAJ DANIA" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </Frame>
                        </toolkit:Expander.Header>
                        <VerticalStackLayout Margin="20,0">
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Śniadania" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Przystawki i przekąski" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Zupy" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Dania główne" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Desery" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Pieczywo i wypieki" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Napoje" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Sosy i dodatki" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </toolkit:Expander>

                    <!-- KUCHNIA ŚWIATA -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Frame Style="{StaticResource FilterSectionStyle}">
                                <Label Text="KUCHNIA ŚWIATA" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </Frame>
                        </toolkit:Expander.Header>
                        <VerticalStackLayout Margin="20,0">
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Polska" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Włoska" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Francuska" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Azjatycka" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Meksykańska" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Śródziemnomorska" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </toolkit:Expander>

                    <!-- GŁÓWNY SKŁADNIK -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Frame Style="{StaticResource FilterSectionStyle}">
                                <Label Text="GŁÓWNY SKŁADNIK" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </Frame>
                        </toolkit:Expander.Header>
                        <VerticalStackLayout Margin="20,0">
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Mięsne" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Rybne i owoce morza" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Wegetariańskie" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Wegańskie" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Bezglutenowe" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </toolkit:Expander>

                    <!-- OKAZJA -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Frame Style="{StaticResource FilterSectionStyle}">
                                <Label Text="OKAZJA" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </Frame>
                        </toolkit:Expander.Header>
                        <VerticalStackLayout Margin="20,0">
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Codzienne obiady" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Świąteczne dania" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Imprezowe przekąski" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Grillowe specjały" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Na wynos i do lunchboxa" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </toolkit:Expander>

                    <!-- STOPIEŃ TRUDNOŚCI -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Frame Style="{StaticResource FilterSectionStyle}">
                                <Label Text="STOPIEŃ TRUDNOŚCI" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </Frame>
                        </toolkit:Expander.Header>
                        <VerticalStackLayout Margin="20,0">
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Szybkie i łatwe" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Średniozaawansowane" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="2,1,0,1" Spacing="8">
                                <CheckBox/>
                                <Label Text="Zaawansowane" TextColor="Black" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </toolkit:Expander>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Wyniki wyszukiwania -->
            <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="20" Padding="10" HasShadow="True">
                <Label Text="Wyniki wyszukiwania pojawią się tutaj..." TextColor="#A85400" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
