<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CookBookApp.Add_Recipe"
             Title="Dodaj Przepis">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Nazwa -->
            <Label Text="Nazwa przepisu:" FontSize="18" FontAttributes="Bold"/>
            <Entry x:Name="RecipeNameEntry" Placeholder="Wpisz nazwę przepisu" MaxLength="200" BackgroundColor="#3B3533" PlaceholderColor="White"/>

            <Grid ColumnSpacing="10" Padding="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rodzaj dania -->
                <VerticalStackLayout Grid.Column="0">
                    <Picker x:Name="DishTypePickerRodzajDania" Title="Wybierz rodzaj dania" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Śniadania</x:String>
                                <x:String>Przystawki i przekąski</x:String>
                                <x:String>Zupy</x:String>
                                <x:String>Dania główne</x:String>
                                <x:String>Desery</x:String>
                                <x:String>Pieczywo i wypieki</x:String>
                                <x:String>Napoje</x:String>
                                <x:String>Sosy i dodatki</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Kuchnia świata -->
                <VerticalStackLayout Grid.Column="1">
                    <Picker x:Name="CuisinePickerKuchniaSwiata" Title="Wybierz kuchnię" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Polska</x:String>
                                <x:String>Włoska</x:String>
                                <x:String>Francuska</x:String>
                                <x:String>Azjatycka</x:String>
                                <x:String>Meksykańska</x:String>
                                <x:String>Śródziemnomorska</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Główny składnik -->
                <VerticalStackLayout Grid.Column="2">
                    <Picker x:Name="MainIngredientPickerGlownySkladnik" Title="Wybierz składnik" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Mięsne</x:String>
                                <x:String>Rybne i owoce morza</x:String>
                                <x:String>Wegetariańskie</x:String>
                                <x:String>Wegańskie</x:String>
                                <x:String>Bezglutenowe</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Okazja -->
                <VerticalStackLayout Grid.Column="3">
                    <Picker x:Name="OccasionPickerOkazja" Title="Wybierz okazję" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Codzienne obiady</x:String>
                                <x:String>Świąteczne dania</x:String>
                                <x:String>Imprezowe przekąski</x:String>
                                <x:String>Grillowe specjały</x:String>
                                <x:String>Dania na wynos i do lunchboxa</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Poziom trudności -->
                <VerticalStackLayout Grid.Column="4">
                    <Picker x:Name="OccasionPickerPoziomTrudnosci" Title="Wybierz" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Easy</x:String>
                                <x:String>Medium</x:String>
                                <x:String>Hard</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

            </Grid>



            <!-- Składniki -->
            <Label Text="Składniki:" FontSize="18" FontAttributes="Bold"/>
            <ScrollView>
                <VerticalStackLayout x:Name="IngredientsList" Spacing="5">

                    <HorizontalStackLayout x:Name="FirstIngredientRow" Spacing="5">

                        <Button Text="-" FontSize="30" TextColor="White" BackgroundColor="Red" WidthRequest="40" HeightRequest="40"/>

                        <!-- Składnik -->
                        <Frame x:Name="IngredientEntryFrame" BorderColor="White" CornerRadius="10" Padding="5" BackgroundColor="Transparent">
                            <Entry x:Name="IngredientEntry" Placeholder="Dodaj składnik ..." MaxLength="200" BackgroundColor="#3B3533" PlaceholderColor="White" WidthRequest="475"/>
                        </Frame>

                        <!-- Ilość -->
                        <Frame x:Name="IngredientAmountFrame" BorderColor="White" CornerRadius="10" Padding="5" BackgroundColor="Transparent">
                            <Entry x:Name="IngredientAmount" Placeholder="0.00" Keyboard="Numeric" BackgroundColor="#3B3533" PlaceholderColor="White" WidthRequest="80"/>
                        </Frame>

                        <!-- Jednostka -->
                        <Frame x:Name="IngredientUnitPickerFrame" BorderColor="White" CornerRadius="10" Padding="5" BackgroundColor="Transparent">
                            <Picker x:Name="IngredientUnitPicker" WidthRequest="110" BackgroundColor="#3B3533" TextColor="White" SelectedIndex="0">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>g</x:String>
                                        <x:String>ml</x:String>
                                        <x:String>szt</x:String>
                                        <x:String>łyżka</x:String>
                                        <x:String>szklanka</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>

                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
            
            <Button x:Name="AddIngredientsButton" Text="+" Clicked="OnAddIngredientClicked" FontSize="24" TextColor="White" BackgroundColor="#3B3533" BorderColor="White" BorderWidth="1" HeightRequest="44"/>

            <!-- Sposób przygotowania -->
            <Label Text="Sposób przygotowania:" FontSize="18" FontAttributes="Bold"/>

            <VerticalStackLayout x:Name="StepsList" Spacing="5">

                <HorizontalStackLayout x:Name="StepRow" Spacing="5">

                    <Button Text="-" FontSize="30" TextColor="White" BackgroundColor="Red" WidthRequest="40" HeightRequest="40"/>

                    <!-- Krok -->
                    <Frame x:Name="StepEntryFrame" BorderColor="White" CornerRadius="10" Padding="5" BackgroundColor="Transparent">
                        <Entry x:Name="StepEntry" Placeholder="Dodaj krok ..." FontAttributes="Italic" MaxLength="500" BackgroundColor="#3B3533" PlaceholderColor="White" WidthRequest="700"/>
                    </Frame>

                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button x:Name="AddStepButton" Text="+" Clicked="OnAddStepsClicked" FontSize="24" TextColor="White" BackgroundColor="#3B3533" BorderColor="White" BorderWidth="1" HeightRequest="44"/>

            <VerticalStackLayout Padding="5" Spacing="20">
                <!-- Pole podglądu zdjęcia -->
                <Image x:Name="RecipeImage" HeightRequest="200" WidthRequest="352" Aspect="AspectFill" BackgroundColor="#3B3533" />

                <!-- Przycisk do wyboru zdjęcia -->
                <Button Text="Dodaj zdjęcie" Clicked="OnAddImageClicked" BackgroundColor="#A85400" TextColor="White" CornerRadius="10"/>
            </VerticalStackLayout>


            <Button Text="Zapisz przepis" TextColor="White" HorizontalOptions="Center" Clicked="OnSaveRecipeClicked" BackgroundColor="#8A543D" BorderColor="White" BorderWidth="2"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
