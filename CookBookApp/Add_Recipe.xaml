<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CookBookApp.Add_Recipe"
             Title="Dodaj Przepis">

    <ContentPage.Resources>
        <!-- Styl dla przycisku minus -->
        <Style x:Key="MinusButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Red"/>
                </Setter.Value>
            </Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="DarkRed"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Red"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Nazwa -->
            <Label Text="Nazwa przepisu:" FontSize="18" FontAttributes="Bold"/>
            <Entry x:Name="RecipeNameEntry" Placeholder="Wpisz nazwę przepisu" MaxLength="200" BackgroundColor="#3B3533" PlaceholderColor="White"/>

            <!-- Pickery -->
            <Grid ColumnSpacing="30" Padding="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rodzaj dania -->
                <VerticalStackLayout Grid.Column="0">
                    <Picker x:Name="DishTypePickerRodzajDania" Title="Rodzaj dania" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Śniadania</x:String>
                                <x:String>Przystawki i przekąski</x:String>
                                <x:String>Zupy</x:String>
                                <x:String>Dania główne</x:String>
                                <x:String>Desery</x:String>
                                <x:String>Pieczywo i wypieki</x:String>
                                <x:String>Napoje</x:String>
                                <x:String>Sosy i dodatki</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Kuchnia swiata -->
                <VerticalStackLayout Grid.Column="1">
                    <Picker x:Name="CuisinePickerKuchniaSwiata" Title="Wybierz kuchnię" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Polska</x:String>
                                <x:String>Włoska</x:String>
                                <x:String>Francuska</x:String>
                                <x:String>Azjatycka</x:String>
                                <x:String>Meksykańska</x:String>
                                <x:String>Śródziemnomorska</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Glowny skladnik -->
                <VerticalStackLayout Grid.Column="2">
                    <Picker x:Name="MainIngredientPickerGlownySkladnik" Title="Wybierz składnik" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Mięsne</x:String>
                                <x:String>Rybne i owoce morza</x:String>
                                <x:String>Wegetariańskie</x:String>
                                <x:String>Wegańskie</x:String>
                                <x:String>Bezglutenowe</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Okazja -->
                <VerticalStackLayout Grid.Column="3">
                    <Picker x:Name="OccasionPickerOkazja" Title="Wybierz okazję" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Codzienne obiady</x:String>
                                <x:String>Świąteczne dania</x:String>
                                <x:String>Imprezowe przekąski</x:String>
                                <x:String>Grillowe specjały</x:String>
                                <x:String>Dania na wynos i do lunchboxa</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Poziom trudnosci -->
                <VerticalStackLayout Grid.Column="4">
                    <Picker x:Name="OccasionPickerPoziomTrudnosci" Title="Poziom trudności:" BackgroundColor="#3B3533" TextColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Easy</x:String>
                                <x:String>Medium</x:String>
                                <x:String>Hard</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

            </Grid>

            <!-- Składniki -->
            <Label Text="Składniki" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
            <ScrollView>
                <VerticalStackLayout x:Name="IngredientsList" Spacing="5">

                    <HorizontalStackLayout Spacing="15">
                        <Button Text="-" Style="{StaticResource MinusButtonStyle}" Clicked="OnRemoveIngredientClicked"/>

                        <Frame BorderColor="White" CornerRadius="5" Padding="5" BackgroundColor="Transparent">
                            <Entry Placeholder="Dodaj składnik ..." MaxLength="400" BackgroundColor="#3B3533" PlaceholderColor="White" WidthRequest="425"/>
                        </Frame>

                        <Frame BorderColor="White" CornerRadius="5" Padding="5" BackgroundColor="Transparent">
                            <Entry Placeholder="0.00" Keyboard="Numeric" BackgroundColor="#3B3533" PlaceholderColor="White" WidthRequest="80"/>
                        </Frame>

                        <Frame BorderColor="White" CornerRadius="5" Padding="5" BackgroundColor="Transparent">
                            <Picker WidthRequest="110" BackgroundColor="#3B3533" TextColor="White" SelectedIndex="0">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>g</x:String>
                                        <x:String>ml</x:String>
                                        <x:String>szt</x:String>
                                        <x:String>łyżka</x:String>
                                        <x:String>szklanka</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <Button x:Name="AddIngredientsButton" Text="+" Clicked="OnAddIngredientClicked" FontSize="24" TextColor="White" BackgroundColor="#3B3533" BorderColor="White" BorderWidth="1" HeightRequest="44"/>

            <!-- Sposob przygotowania -->
            <Label Text="Sposób przygotowania:" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>

            <VerticalStackLayout x:Name="StepsList" Spacing="5">

                <HorizontalStackLayout Spacing="15">
                    <Button Text="-" Style="{StaticResource MinusButtonStyle}" Clicked="OnRemoveStepClicked"/>

                    <Frame BorderColor="White" CornerRadius="5" Padding="5" BackgroundColor="Transparent">
                        <Entry Placeholder="Dodaj krok ..." FontAttributes="Italic" MaxLength="500" BackgroundColor="#3B3533" PlaceholderColor="White" WidthRequest="670"/>
                    </Frame>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button x:Name="AddStepButton" Text="+" Clicked="OnAddStepsClicked" FontSize="24" TextColor="White" BackgroundColor="#3B3533" BorderColor="White" BorderWidth="1" HeightRequest="44"/>

            <!-- Zdjecie -->
            <VerticalStackLayout Padding="5" Spacing="20">
                <Image x:Name="RecipeImage" HeightRequest="200" WidthRequest="352" Aspect="AspectFill" BackgroundColor="#3B3533" />
                <Button Text="Dodaj zdjęcie" Clicked="OnAddImageClicked" BackgroundColor="#A85400" TextColor="White" CornerRadius="10"/>
            </VerticalStackLayout>

            <Button Text="Zapisz przepis" TextColor="White" HorizontalOptions="Center" Clicked="OnSaveRecipeClicked" BackgroundColor="#8A543D" BorderColor="White" BorderWidth="2"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
